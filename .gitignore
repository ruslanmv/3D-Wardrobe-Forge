# Generated fixtures and any real avatars dropped in for local testing.
assets/fixtures/*.vrm
assets/fixtures/*.glb

# The Studio's avatar library: fetched and sha256-verified by
# tools/fetch_library.py against assets/library/models.json, never committed.
assets/library/*.vrm

# Local job state and generated artifacts (WARDROBE_STORAGE_ROOT default)
.wardrobe/

# scripts/download.py: VRoid Hub models (fetched, like the library above) and
# the saved sign-in. The manifest and licence snapshots beside them are committed.
assets/library/vroid/*.vrm
assets/library/vroid/*.part
.vroid-token.json
