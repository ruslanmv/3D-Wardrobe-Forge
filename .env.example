# Copy to .env and adjust. Every value here is a default that works locally.

# ---------------------------------------------------------------- service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=INFO
# Absolute base URL used when minting artifact URLs. Leave empty for relative.
PUBLIC_BASE_URL=http://localhost:8080
# local | space | production
WARDROBE_PROFILE=local
# yourfriend | generic
WARDROBE_TARGET=yourfriend
# Comma-separated values are parsed by pydantic-settings when provided as JSON,
# e.g. ["https://yourfriend.online","https://staging.yourfriend.online"]
WARDROBE_ALLOWED_ORIGINS=["*"]
# none | api_key
WARDROBE_AUTH_MODE=none
WARDROBE_API_KEY=
# The Studio's admin sign-in (bottom-left account menu), where adult declarations
# are made per avatar for that session only. Empty = no admin. 12+ characters;
# on a Space, set it as a secret.
WARDROBE_ADMIN_PASSWORD=

# ---------------------------------------------------------------- pipeline
# auto = use Blender when the binary is present, otherwise the native engine.
WARDROBE_ENGINE=auto
# template (production) | mock (tests) | meshy | tripo (experimental)
WARDROBE_PROVIDER=template
# memory | redis://host:port/db
WARDROBE_JOB_BACKEND=memory
WARDROBE_JOB_CONCURRENCY=2
WARDROBE_JOB_TIMEOUT_S=900

# ---------------------------------------------------------------- storage
# local | s3
WARDROBE_STORAGE_BACKEND=local
# Writable local state. Docker deployments override this with /data/wardrobe.
WARDROBE_STORAGE_ROOT=.wardrobe

S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL_S=3600

# ---------------------------------------------------------------- safety
MAX_AVATAR_BYTES=134217728
MAX_OUTPUT_BYTES=268435456
FETCH_TIMEOUT_S=60
# Reject a source model whose usage terms we cannot read, unless the caller
# attests that modification is permitted. Turn this off only in closed setups.
STRICT_LICENSING=true
# Refuse to fetch source avatars from private/loopback addresses (SSRF guard).
BLOCK_PRIVATE_NETWORKS=true
# Delete the fetched source VRM and scratch files once a job finishes.
DELETE_SOURCE_AFTER_JOB=true

# ---------------------------------------------------------------- providers
# Only needed for outfit.mode="generated".
MESHY_API_KEY=
MESHY_BASE_URL=https://api.meshy.ai
TRIPO_API_KEY=
TRIPO_BASE_URL=https://api.tripo3d.ai
PROVIDER_TIMEOUT_S=600

# ---------------------------------------------------------------- blender
BLENDER_BIN=blender
BLENDER_TIMEOUT_S=900
WARDROBE_BLENDER_SCRIPT=/app/worker/blender/run_pipeline.py
