WARDROBE_PROFILE=space
APP_HOST=0.0.0.0
APP_PORT=8080
PUBLIC_BASE_URL=https://YOUR-SPACE.hf.space

WARDROBE_ENGINE=native
WARDROBE_PROVIDER=template
WARDROBE_JOB_BACKEND=memory
WARDROBE_JOB_CONCURRENCY=1
WARDROBE_STORAGE_BACKEND=local
WARDROBE_STORAGE_ROOT=/data/wardrobe

WARDROBE_ALLOWED_ORIGINS=["https://yourfriend.online"]
WARDROBE_AUTH_MODE=api_key
WARDROBE_API_KEY=CHANGE_ME
# A secret, not a variable. Enables the Studio's admin sign-in; see README.md.
WARDROBE_ADMIN_PASSWORD=
