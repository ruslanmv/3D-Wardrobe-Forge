{
    "name": "wardrobe-studio-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "The next Wardrobe Studio (UI-002): React + TypeScript over the existing viewer and API client.",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "typecheck": "tsc -b --pretty false",
        "lint": "eslint .",
        "test": "vitest run",
        "e2e": "playwright test",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@pixiv/three-vrm": "3.4.4",
        "@radix-ui/react-dialog": "1.3.1",
        "@radix-ui/react-slider": "1.6.1",
        "@radix-ui/react-tabs": "1.2.1",
        "@radix-ui/react-toggle-group": "1.2.1",
        "@radix-ui/react-tooltip": "1.4.1",
        "clsx": "2.1.1",
        "lucide-react": "1.61.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "three": "0.179.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.1",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@types/node": "22.20.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/three": "0.179.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "10.13.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "jsdom": "29.1.1",
        "prettier": "3.9.10",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
